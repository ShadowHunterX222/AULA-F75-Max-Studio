{
  "name": "aula-f75-max-studio",
  "version": "0.9.1",
  "private": true,
  "description": "Unofficial AULA F75 Max desktop driver for USB-C and 2.4 GHz receiver modes, with global reactive input and 120 Studio RGB effects",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "test": "node test-protocol.mjs && node test-desktop-hid.mjs && node test-reactive-input.mjs && node test-effects-library.mjs && node test-effect-tuning.mjs && node test-light-chase.mjs && node test-wireless-protocol.mjs && node test-packaging-config.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.aulastudio.f75max",
    "productName": "AULA F75 Max Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "protocol.js",
      "effects.js",
      "keymap.json",
      "desktop/**/*",
      "build/**/*",
      "README.md",
      "PROTOCOL-STATUS.md",
      "LICENSE",
      "package.json",
      "reactive-key-map.json",
      "CHANGELOG-v0.9.1.md"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AULA-F75-Max-Studio-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "AULA-F75-Max-Studio-Portable-${version}.${ext}"
    },
    "asar": true,
    "compression": "normal",
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}
