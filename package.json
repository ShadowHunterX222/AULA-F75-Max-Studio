{
  "name": "aula-f75-max-studio",
  "version": "0.8.1",
  "private": true,
  "description": "Unofficial AULA F75 Max desktop driver with global reactive input, 120 software-rendered RGB effects, per-effect tuning and curated palettes",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "test": "node test-protocol.mjs && node test-desktop-hid.mjs && node test-reactive-input.mjs && node test-effects-library.mjs && node test-effect-tuning.mjs && node test-light-chase.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win:installer": "electron-builder --win nsis --x64",
    "dist:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.aulastudio.f75max",
    "productName": "AULA F75 Max Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "protocol.js",
      "effects.js",
      "keymap.json",
      "desktop/**/*",
      "build/**/*",
      "README.md",
      "PROTOCOL-STATUS.md",
      "LICENSE",
      "package.json",
      "reactive-key-map.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AULA-F75-Max-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AULA-F75-Max-Studio-Portable-${version}.${ext}"
    },
    "asar": true,
    "compression": "normal",
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  }
}